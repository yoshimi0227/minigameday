{
  "name": "minigameday",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && tsc -p dashboard",
    "watch": "tsc -w",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepare": "lefthook install",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "dashboard": "vp dev dashboard --open",
    "dashboard:build": "vp build dashboard",
    "cdk": "cdk",
    "synth": "cdk synth",
    "synth:nag": "cdk synth -c nag=true --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "destroy": "cdk destroy --all",
    "drift": "cdk drift",
    "reset": "tsx scripts/reset-gameday.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1114.0",
    "@aws-sdk/client-cloudformation": "^3.1114.0",
    "@aws-sdk/client-dynamodb": "^3.1114.0",
    "@aws-sdk/client-fis": "^3.1114.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-oxc": "^0.4.3",
    "@voidzero-dev/vite-plus-core": "^0.2.9",
    "aws-cdk": "2.1138.0",
    "cdk-nag": "^2.38.2",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "oxlint-plugin-awscdk": "^0.1.5",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite-plus": "^0.2.9",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@cdklabs/deploy-time-build": "^0.1.7",
    "aws-cdk-lib": "^2.266.0",
    "aws-icons": "^3.3.0",
    "constructs": "^10.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.16.0",
      "onFail": "download"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "lefthook@2.1.10": true,
    "fsevents@2.3.3": true
  }
}
